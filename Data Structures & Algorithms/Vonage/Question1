public int minPasses(String[] days) {
    if (days == null || days.length == 0) return 0;

    Map<String, Integer> dayIndex = new HashMap<>();
    String[] order = {"sun", "mon", "tue", "wed", "thu", "fri", "sat"};
    for (int i = 0; i < order.length; i++) {
        dayIndex.put(order[i], i);
    }

    int passes = 1;
    int prev = dayIndex.get(days[0]);

    for (int i = 1; i < days.length; i++) {
        int curr = dayIndex.get(days[i]);
        if (curr <= prev) passes++;
        prev = curr;
    }

    return passes;
}
